<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
  <name>Bedok Reservoir - SAR sector</name>
  <description>APPROXIMATE. The reservoir outline is drawn from its rough position and shape,
  not surveyed or traced from imagery; the GeoFence is an arbitrary polygon around it. Good
  enough to exercise the planner, not to brief a real sortie. A real flight here would also
  need CAAS clearance - this is inside Singapore and close to Paya Lebar Air Base.</description>
  <Placemark>
    <name>GCSlocation</name>
    <description>Staging point on the south bank, Bedok Reservoir Park</description>
    <Point><coordinates>103.93042173,1.33655927,0</coordinates></Point>
  </Placemark>
  <Placemark>
    <name>GeoFence</name>
    <description>Hard boundary - no waypoint or leg may leave this</description>
    <Polygon><outerBoundaryIs><LinearRing><coordinates>
      103.94008082,1.34266740,0
      103.93722321,1.34687540,0
      103.93146935,1.34841964,0
      103.92480311,1.34684737,0
