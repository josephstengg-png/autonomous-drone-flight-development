      103.92735080,1.33575226,0
      103.93087833,1.33426335,0
      103.93722073,1.33628926,0
      103.94008082,1.34266740,0
    </coordinates></LinearRing></outerBoundaryIs></Polygon>
  </Placemark>
  <Placemark>
    <name>OpsArea</name>
    <description>The water itself - search area is the reservoir surface</description>
    <Polygon><outerBoundaryIs><LinearRing><coordinates>
